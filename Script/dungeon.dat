/* Team data for the game */

Teams = 19;

/*
 * Description of hard-coded teams:
 *  0 == PLAYER_TEAM == Player and pets.
 *  1 == MONSTER_TEAM == Monsters, by default hostile.
 *  2 == VALPURIS_TEAM == Residents of Valpuris.
 *  3 == SUMO_TEAM == Huang Ming Pong during an arena fight.
 *  4 == ANGEL_TEAM == Spawned hostile angels.
 *  5 == GUILD_TEAM == Dungeon shopkeepers.
 *  6 == COMMUNIST_TEAM == Ivan and Shadowpaw.
 *  7 == OAKHAVEN_TEAM == Natives of Oakhaven.
 *  8 == COLONIST_TEAM == Colonists of Oakhaven.
 *  9 == TOURIST_GUIDE_TEAM == Dummy team which holds the village elder, whom the tourists follow.
 * 10 == TOURIST_TEAM == Tourists of Oakhaven.
 * 11 == BETRAYED_TEAM == Pets which the player has angered.
 * 12 == CRYPT_OF_KHAZ_ZADM_ENTRY_TEAM == Guards at the Crypt entrance.
 * 13 == CRYPT_OF_KHAZ_ZADM_NECRO_TEAM == Necro chamber operators in Khaz-Zadm's crypt.
 * 14 == XINROCH_TOMB_KAMIKAZE_DWARF_TEAM == The fanatics in the gas chambers.
 * 15 == PRISONER_TEAM == Prisoners in the Cathedral Cellar.
 * 16 == TERRA_TEAM == Terra in the Crystal Cave.
 * 17 == ASLONA_TEAM == People loyal to Aslona.
 * 18 == REBEL_TEAM == The rebels.
 */

Team VALPURIS_TEAM;
{
  Relation 0, UNCARING;
  KillEvilness = 50;
}

Team SUMO_TEAM;
{
  Relation 0, HOSTILE;
}

Team ANGEL_TEAM;
{
  Relation 0, HOSTILE;
  Relation 1, UNCARING;
}

Team GUILD_TEAM;
{
  Relation 1, UNCARING;
  KillEvilness = 100;
}

Team COMMUNIST_TEAM;
{
  KillEvilness = 100;
}

Team OAKHAVEN_TEAM;
{
  KillEvilness = 50;
}

Team COLONIST_TEAM;
{
  Relation 7, FRIEND;
}

Team TOURIST_GUIDE_TEAM;
{
  Relation 7, FRIEND;
  Relation 8, FRIEND;
  KillEvilness = 50;
}

Team TOURIST_TEAM;
{
  Relation 7, FRIEND;
  Relation 8, FRIEND;
  KillEvilness = 10;
}

Team BETRAYED_TEAM;
{
  Relation 0, HOSTILE;
  KillEvilness = 10;
}

Team CRYPT_OF_KHAZ_ZADM_ENTRY_TEAM;
{
  Relation 0, UNCARING;
  Relation 1, UNCARING;
  KillEvilness = 50;
}

Team CRYPT_OF_KHAZ_ZADM_NECRO_TEAM;
{
  Relation 1, UNCARING;
  KillEvilness = 50;
}

Team XINROCH_TOMB_KAMIKAZE_DWARF_TEAM;
{
  Relation 1, UNCARING;
  KillEvilness = 100;
}

Team PRISONER_TEAM;
{
  Relation 1, UNCARING;
  /*Relation 17, FRIEND;
  Relation 18, FRIEND;*/
  KillEvilness = 100;
}

Team TERRA_TEAM;
{
  Relation 1, UNCARING;
  Relation 2, HOSTILE;
  Relation 7, FRIEND;
  KillEvilness = 150;
}

Team ASLONA_TEAM;
{
  Relation 0, UNCARING;
  Relation 18, HOSTILE;
  KillEvilness = 50;
}

Team REBEL_TEAM;
{
  Relation 17, HOSTILE;
  KillEvilness = 50;
}

/* Dungeons to be included in the game */

Include "dungeons/";
